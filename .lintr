linters: linters_with_defaults(
    indentation_linter = NULL,
    object_usage_linter = NULL,
    object_name_linter = object_name_linter("snake_case"),
    commented_code_linter = commented_code_linter(),
    unnecessary_concatenation_linter = unnecessary_concatenation_linter(),
    line_length_linter = line_length_linter(120),
    cyclocomp_linter = NULL,
    return_linter = return_linter(),
    unnecessary_lambda_linter = unnecessary_lambda_linter()
  )
exclusions: list(
    "tests/testthat/fixtures",
    "data-raw"
  )
